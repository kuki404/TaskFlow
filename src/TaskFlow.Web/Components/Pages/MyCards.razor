@page "/my-cards"
@attribute [Authorize]
@using TaskFlow.Application.Dtos
@inject TaskFlowApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>My cards - TaskFlow</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">My cards</MudText>

@if (cards is null)
{
    <MudSkeleton Width="100%" Height="80px" Class="mb-2" />
    <MudSkeleton Width="100%" Height="80px" />
}
else if (cards.Count == 0)
{
    <MudAlert Severity="Severity.Info">No cards are assigned to you.</MudAlert>
}
else
{
    @foreach (var group in cards.GroupBy(c => new { c.ProjectId, c.ProjectName }).OrderBy(g => g.Key.ProjectName))
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">@group.Key.ProjectName</MudText>
        <MudGrid>
            @foreach (var card in group)
            {
                <MudItem xs="12" md="4">
                    <MudCard Outlined="true" Class="@(IsOverdue(card) ? "border-error" : string.Empty)"
                             Style="@(IsOverdue(card) ? "border: 2px solid var(--mud-palette-error);" : string.Empty)">
                        <MudCardContent>
                            <div style="display:flex; align-items:center; justify-content:space-between;">
                                <MudText Typo="Typo.subtitle1">@card.Title</MudText>
                                @if (IsOverdue(card))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Overdue</MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@card.CardListName</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@PriorityColor(card.Priority)" Class="mt-1">@card.Priority</MudChip>
                            @if (card.DueDateUtc is not null)
                            {
                                <MudText Typo="Typo.caption" Class="d-block mt-1">Due @card.DueDateUtc.Value.ToShortDateString()</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/boards/{card.BoardId}"))">Open board</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private IReadOnlyList<MyCardDto>? cards;

    protected override async Task OnInitializedAsync() => cards = await ApiClient.GetMyCardsAsync() ?? [];

    private static bool IsOverdue(MyCardDto card) =>
        card.DueDateUtc is not null && card.DueDateUtc < DateTime.UtcNow && !card.CardListName.Equals("Done", StringComparison.OrdinalIgnoreCase);

    private static Color PriorityColor(TaskFlow.Domain.Enums.CardPriority priority) => priority switch
    {
        TaskFlow.Domain.Enums.CardPriority.Urgent => Color.Error,
        TaskFlow.Domain.Enums.CardPriority.High => Color.Warning,
        TaskFlow.Domain.Enums.CardPriority.Medium => Color.Info,
        _ => Color.Default
    };
}
