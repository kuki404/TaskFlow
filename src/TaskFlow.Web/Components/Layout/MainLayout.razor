@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="@isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => drawerOpen = !drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2">TaskFlow</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleTheme" aria-label="Toggle dark mode" />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-2">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" aria-label="Log out" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="drawerOpen" Elevation="0" Variant="DrawerVariant.Mini">
        <NavMenu />
    </MudDrawer>
    <MudMainContent id="main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error">Something went wrong rendering this page. Try reloading.</MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;
    private bool isDarkMode;

    [Inject] private ThemeService ThemeService { get; set; } = default!;
    [Inject] private TaskFlowApiClient ApiClient { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // ProtectedBrowserStorage needs a live JS interop connection, which does not exist yet during
    // static prerendering — loading the saved theme has to wait for the first real render after
    // the Blazor Server circuit is up, not OnInitializedAsync (which runs during prerender too).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.LoadAsync();
            isDarkMode = ThemeService.IsDarkMode ?? true;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await ThemeService.SetAsync(isDarkMode);
    }

    private async Task Logout()
    {
        await ApiClient.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
