<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="@Label" @bind-Value="value" Required="true" MaxLength="MaxLength" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@SubmitText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string SubmitText { get; set; } = "Create";
    [Parameter] public int MaxLength { get; set; } = 200;
    [Parameter] public string? InitialValue { get; set; }

    private string value = string.Empty;

    protected override void OnInitialized() => value = InitialValue ?? string.Empty;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(value.Trim()));
    }

    private void Cancel() => MudDialog.Cancel();
}
